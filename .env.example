# Optional: Product Hunt Developer Token (if using official GraphQL API)
# PRODUCT_HUNT_DEVELOPER_TOKEN=your_token_here

# Optional: Gemini API Key for rich qualitative commentary
# GEMINI_API_KEY=your_key_here

# Automatically populated by Vercel when attaching Vercel Postgres (Neon)
# POSTGRES_URL=postgres://default:xxx@ep-xxx.postgres.vercel-storage.com:5432/verceldb
